# Backend API base URL. Leave empty for local dev (Vite proxies /api).
# For production (Vercel), set to your deployed backend, e.g.:
# VITE_API_URL=https://your-app.onrender.com/api
VITE_API_URL=

# Optional: richer alternative routes via OpenRouteService (not required —
# the app uses keyless Valhalla/OSRM by default).
# VITE_ORS_API_KEY=
