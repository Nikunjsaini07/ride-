# Server
PORT=5000
NODE_ENV=development

# MongoDB. Use the STANDARD connection string (mongodb://host1,host2,host3/db?...)
# rather than mongodb+srv:// if your network blocks DNS SRV lookups.
MONGO_URI=mongodb://127.0.0.1:27017/sug_rideshare

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed frontend origins (CORS).
CLIENT_URL=http://localhost:5173

# Brevo (Sendinblue) transactional email — for password reset.
BREVO_API=your_brevo_api_key
# Must be a VERIFIED sender in your Brevo account (Senders & IP -> Senders).
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=SUG RideShare

# Optional: override DNS servers used for mongodb+srv:// lookups.
# DNS_SERVERS=8.8.8.8,1.1.1.1
